# Copy to .env.docker and replace each REPLACE_ME value with a distinct secret.
# Database user passwords in DSNs may contain letters, digits, underscores and hyphens.
# Port host untuk frontend (kosong, siap diarahkan dari Cloudflare Tunnel ke http://127.0.0.1:8095)
SIMP2M_FRONTEND_PORT=8095
# Port host opsional untuk debug/healthcheck backend API
SIMP2M_BACKEND_PORT=8096

# Origin publik tempat aplikasi diakses di browser (bisa dipisah koma jika lebih dari satu):
# - Untuk uji lokal: http://localhost:8095,http://127.0.0.1:8095
# - Saat sudah pakai Cloudflare Tunnel HTTPS: https://simp2m.domainanda.com
SIMP2M_WEB_ORIGIN=http://localhost:8095,http://127.0.0.1:8095

# Kredensial MariaDB internal Docker
SIMP2M_DB_ROOT_PASSWORD=REPLACE_ME_ROOT
SIMP2M_DB_DSN=simp2m_app:REPLACE_ME_DB_DSN@tcp(db:3306)/simp2m_dev?parseTime=true
SIMP2M_MIGRATION_DSN=simp2m_migrator:REPLACE_ME_MIGRATION_DSN@tcp(db:3306)/simp2m_dev?parseTime=true
SIMP2M_TRIAL_DSN=simp2m_trial_app:REPLACE_ME_TRIAL_DSN@tcp(db:3306)/simp2m_dev_trial?parseTime=true
SIMP2M_TRIAL_MIGRATION_DSN=simp2m_trial_migrator:REPLACE_ME_TRIAL_MIGRATION_DSN@tcp(db:3306)/simp2m_dev_trial?parseTime=true
